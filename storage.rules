rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Video files uploaded from the admin dashboard.
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Video thumbnails uploaded from the admin dashboard.
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profile / avatar photo.
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
